# Backend Environment Variables Template
# Copy to `backend/.env` and fill in real values.
# NEVER commit a real `.env` to source control.

# Environment: "development" (default) or "production"
APP_ENV=development

# --- Database ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- SQLite ---
SQLITE_PATH=./data/sqlite/app.db

# --- LLM / Embedding API Keys ---
SILICON_FLOW_API_KEY=
SILICON_FLOW_BASE_URL=https://api.siliconflow.cn/v1
# LLM key (powers chat via the OpenAI-compatible mode).
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-flash
# Dedicated, scoped key for the multimodal embedding model
# (qwen3-vl-embedding). Same DashScope provider, separate quota.
# Either spelling is accepted; the LLM key above is the fallback when
# this is left empty.
BAILIAN_API_KEY_Qwen-VL-Embedding=

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-strong-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Upload ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=10485760

# --- Embedding ---
# Provider: "dashscope" (multimodal qwen3-vl-embedding, text + images) or
# "siliconflow" (text-only). WARNING: this is a HARD switch, not a failover —
# the providers' vector spaces are incompatible. After changing it you MUST
# stop the backend and re-run: python scripts/migrate_embeddings.py --yes
# The dashscope provider authenticates with BAILIAN_API_KEY above.
EMBEDDING_PROVIDER=dashscope
# SiliconFlow provider model (used only when EMBEDDING_PROVIDER=siliconflow)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# DashScope provider model (used only when EMBEDDING_PROVIDER=dashscope)
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
# Pinned output dimension for EVERY provider (dashscope requests it via MRL).
# Changing this requires a full re-embed.
EMBEDDING_DIM=1024

# --- CORS ---
# Comma-separated list of allowed origins. NEVER use "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
