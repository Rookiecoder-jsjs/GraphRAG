# Backend Environment Variables Template
# Copy to `backend/.env` and fill in real values.
# NEVER commit a real `.env` to source control.

# Environment: "development" (default) or "production"
APP_ENV=development

# --- Database ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- SQLite ---
SQLITE_PATH=./data/sqlite/app.db

# --- LLM / Embedding API Keys ---
SILICON_FLOW_API_KEY=
SILICON_FLOW_BASE_URL=https://api.siliconflow.cn/v1
# 多密钥池（可选，ADR-009）：逗号分隔多把 SiliconFlow key，embedding + rerank
# 共用并按 least-inflight 分摊；429 时冷却该 key 并立即换下一把。留空则回退上面的单 key。
SILICON_FLOW_API_KEYS=
SILICON_FLOW_PER_KEY_CONCURRENCY=8
SILICON_FLOW_KEY_LEASE_TIMEOUT=20
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-flash

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-strong-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Upload ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=10485760

# --- Embedding Model ---
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1024
# 每次 /embeddings 请求的输入条数（查询路径 ≤4 条单批；摄取路径按此分批）
EMBED_BATCH_SIZE=32
# 多于一批时的批间间隔秒数（仅摄取路径）
EMBED_BATCH_DELAY_SECONDS=0.3

# --- 查询并发闸（ADR-009）---
# 同时运行的完整检索数上限；超出排队，排队超过 QUERY_MAX_QUEUE_SECONDS 拒绝
# （/api/search 返回 429 + Retry-After；聊天流收到终端 error 事件）。缓存命中不占名额。
QUERY_CONCURRENCY=4
QUERY_MAX_QUEUE_SECONDS=5

# --- CORS ---
# Comma-separated list of allowed origins. NEVER use "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./data/logs
# 留空时按 APP_ENV 自动：development=text / production=json；显式 text/json 总生效。
# LOG_FORMAT=json

